{
	"name": "@hoardodile/plugin-manga",
	"version": "0.1.7",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "hoardodile plugin dev --data testdata/pages",
		"build": "hoardodile plugin build",
		"watch": "hoardodile plugin build --watch",
		"testdata": "node scripts/make-testdata.mjs",
		"testdata:real": "node scripts/fetch-real-samples.mjs && node scripts/verify-real-samples.mjs",
		"detect:smoke": "hoardodile plugin run detect testdata/pages --plugin-dir dist",
		"lint": "biome check . && tsc --noEmit",
		"format": "biome check --write",
		"lint-staged": "lint-staged --max-arg-length=6000",
		"postinstall": "node scripts/setup-hooks.mjs",
		"test": "vitest run",
		"readme:check": "node scripts/check-readme.mjs",
		"release": "node scripts/release.mjs"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"release-it": {
		"git": {
			"commitMessage": "chore(release): v${version}",
			"tagName": "v${version}",
			"requireBranch": "main"
		},
		"github": {
			"release": false
		},
		"npm": {
			"publish": false,
			"allowSameVersion": true
		},
		"plugins": {
			"@release-it/conventional-changelog": {
				"preset": {
					"name": "conventionalcommits"
				},
				"infile": "CHANGELOG.md"
			}
		},
		"hooks": {
			"after:bump": "node scripts/sync-version.mjs"
		}
	},
	"dependencies": {
		"@hoardodile/sdk-react": "^0.1.8",
		"@hoardodile/sdk-server": "^0.1.8",
		"@hoardodile/sdk-types": "^0.1.8",
		"@hoardodile/sdk-web": "^0.1.8",
		"@hoardodile/ui": "^0.1.8",
		"@tanstack/react-virtual": "^3.14.9",
		"@solar-icons/react": "^2.1.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-zoom-pan-pinch": "^4.0.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@hoardodile/7z-bin": "^1.1.3",
		"@hoardodile/cli": "^0.1.8",
		"@hoardodile/host": "^0.1.8",
		"@hoardodile/host-web": "^0.1.8",
		"@hoardodile/workbench": "^0.1.8",
		"@release-it/conventional-changelog": "^12.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"jsdom": "^30.0.1",
		"lefthook": "^2.1.10",
		"lint-staged": "^17.3.0",
		"release-it": "^21.0.2",
		"shadcn": "^4.19.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	}
}
